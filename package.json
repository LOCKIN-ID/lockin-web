{
  "name": "lockin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "brand:extract": "python scripts/extract-brand.py",
    "wasm:sync": "node scripts/sync-wasm.mjs",
    "ebook:pdf": "node scripts/build-ebook-pdf.mjs",
    "qr:build": "tsx scripts/build-qr.ts",
    "mail": "npx maildev -s 1025 -w 1080",
    "cron:dev": "tsx scripts/dev-cron.ts",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "design:lint": "node scripts/design-lint.mjs",
    "design:lint:render": "node scripts/design-lint-render.mjs",
    "predev": "npm run wasm:sync",
    "prebuild": "npm run wasm:sync"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@libsql/client": "0.18.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.12",
    "better-sqlite3": "13.0.3",
    "lenis": "^1.3.27",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wasi-sh": "0.11.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
