# LOCK.IN · environment. Every value the app reads, with a safe local default.
# Copy to `.env` — not `.env.local`. The Prisma CLI (`prisma.config.ts`) and the seed
# (`prisma/seed.ts`) both load `.env` only, so anything in `.env.local` is invisible to
# `npm run db:deploy` and `npm run db:seed`. Nothing here is required to run the offline
# demo: no paid key is needed for any surface.

# ---- database -------------------------------------------------------------
# sqlite (default, local file) | libsql (Turso, Vercel) | d1 (Cloudflare)
DB_DRIVER="sqlite"
DATABASE_URL="file:./prisma/dev.db"
# DB_DRIVER=libsql
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ---- auth -----------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="lockin-development-secret-change-me-please-32chars"
BETTER_AUTH_URL="http://localhost:3000"
SEED_ADMIN_PASSWORD="lockin-admin-2026"

# ---- ai tutor -------------------------------------------------------------
# offline (deterministic Socratic engine, needs no key) | openrouter | gemini
TUTOR_PROVIDER="offline"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ---- payments -------------------------------------------------------------
# mock (default) | midtrans
PAYMENTS_PROVIDER="mock"
MOCK_PAYMENTS="1"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_BASE="https://app.sandbox.midtrans.com"

# ---- email ----------------------------------------------------------------
# smtp (MailDev locally) | resend
EMAIL_TRANSPORT="smtp"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="LOCK.IN <hello@lockin.test>"
RESEND_API_KEY=""

# ---- storage --------------------------------------------------------------
# local (default, ./storage) | s3 (any S3-compatible endpoint: R2, Supabase, MinIO, B2)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- jobs and support -----------------------------------------------------
CRON_SECRET="dev-cron-secret"
WHATSAPP_SUPPORT_URL=""
APP_URL="http://localhost:3000"
